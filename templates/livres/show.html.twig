{% extends 'base.html.twig' %}

{% block title %}Détail du livre{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">{{ livre.titre }}</h1>

    <div class="row">
        <div class="col-md-4">
            <img src="{{ livre.image }}" alt="{{ livre.titre }}" class="img-fluid rounded shadow-sm">
        </div>
        <div class="col-md-8">
            <p><strong>Prix :</strong> {{ livre.prix }} €</p>
            <p><strong>ISBN :</strong> {{ livre.isbn }}</p>
            <p><strong>Éditeur :</strong> {{ livre.editeur }}</p>
            <p><strong>Date d'édition :</strong> {{ livre.dateEdition ? livre.dateEdition|date('d/m/Y') : 'N/A' }}</p>
            
            <p><strong>Résumé :</strong><br> {{ livre.resume }}</p>

            <a href="{{ path('admin_livres') }}" class="btn btn-secondary mt-3">← Retour aux livres</a>
        </div>
    </div>
</div>
{% endblock %}
